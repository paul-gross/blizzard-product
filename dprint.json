{
  "markdown": {
    // maintain, not never: canon:no-hard-wrap blesses both paragraph-per-line and sentence-per-line; never would collapse sentence-per-line files
    "textWrap": "maintain",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes"
  },
  "excludes": [],
  "plugins": ["https://plugins.dprint.dev/markdown-0.22.1.wasm"]
}
